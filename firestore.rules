rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Reglas para la colección rosary_times
    // Permite lectura pública a todos los usuarios para cargar los tiempos del Rosario
    // Permite escritura para actualizar los tiempos
    match /rosary_times/{document=**} {
      allow read, write: if true;
    }

    // Regla general para el periodo de desarrollo (válida hasta 2026-12-02)
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 12, 2);
    }
  }
}
